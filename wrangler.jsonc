{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The deployed site. Local dev uses the same config with local (miniflare)
  // storage; .dev.vars overrides the vars below for localhost.
  // To add a staging environment later, add an "env": { "alpha": { ... } } block.
  "name": "deep-cities",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "main": "app/server.ts",
  // Only deepcities.org: no workers.dev address.
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    "APP_ENV": "live",
    // The one address; www redirects here (app/lib/redirects.server.ts).
    "SITE_ORIGIN": "https://deepcities.org",
    // Cloudflare Email Service sending is onboarded for deepcities.org;
    // Email Routing forwards replies to hello@ to the owner.
    "EMAIL_FROM_ADDRESS": "hello@deepcities.org"
  },
  "routes": [
    { "pattern": "deepcities.org", "custom_domain": true },
    { "pattern": "www.deepcities.org", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deep-cities",
      "database_id": "8dffda18-146a-453b-bbe6-394d5b6daa46",
      "migrations_dir": "app/lib/db/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "deep-cities" },
    // Nightly database dumps and a copy of the photos (app/lib/backup.server.ts).
    { "binding": "BACKUPS", "bucket_name": "deep-cities-backups" }
  ],
  // The backup, nightly at 03:17 UTC.
  "triggers": { "crons": ["17 3 * * *"] },
  // Dumping the database takes more than the default 30 s of CPU as it grows.
  "limits": { "cpu_ms": 120000 },
  "send_email": [{ "name": "EMAIL" }]
}
