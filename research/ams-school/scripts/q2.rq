SELECT ?item ?itemLabel ?coord ?image ?inception ?archLabel ?rm ?nlwiki ?instLabel ?styleLabel WHERE {
  VALUES ?archName { "Michel de Klerk"@en "Piet Kramer"@en "Joan van der Mey"@en "Jan Gratama"@en "Jan Frederik Staal"@en "Margaret Staal-Kropholler"@en "Hendrik Wijdeveld"@en "Jan Boterenbrood"@en "Arend Jan Westerman"@en "Nico Lansdorp"@en "Dick Greiner"@en "Harry Elte"@en "Johannes Christiaan van Epen"@en "Jan Wils"@en "Cornelis Kruyswijk"@en "Gerrit Jan Rutgers"@en "Jo Mulder"@en "Hendrik Petrus Berlage"@en "Jan Kuijt"@en "Ferdinand Jantzen"@en "Frans Ottenhof"@en "Klaas van Gendt"@en "Hendrik Wouda"@en "Guillaume la Croix"@en "Willem Noorlander"@en "Jop van Epen"@en "Piet Vorkink"@en "Jan Hendrik Slot"@en "Pieter Lucas Marnette"@en "Hijman Louis de Jong"@en "Jordanus Roodenburgh"@en "Arnold Ingwersen"@en "Willem Greve"@en "Anton Hendrik Wegerif"@en "Jacob Kropholler" }
  ?arch rdfs:label ?archName .
  ?item wdt:P84 ?arch ; wdt:P625 ?coord .
  FILTER(geof:latitude(?coord) > 52.27 && geof:latitude(?coord) < 52.44 && geof:longitude(?coord) > 4.72 && geof:longitude(?coord) < 5.08)
  OPTIONAL { ?item wdt:P18 ?image }
  OPTIONAL { ?item wdt:P571 ?inception }
  OPTIONAL { ?item wdt:P359 ?rm }
  OPTIONAL { ?item wdt:P31 ?inst }
  OPTIONAL { ?item wdt:P149 ?style }
  OPTIONAL { ?nlwiki schema:about ?item ; schema:isPartOf <https://nl.wikipedia.org/> }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "nl,en". }
}
