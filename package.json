{
  "name": "deep-cities",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file scripts/seed.sql",
    "re-seed": "bash scripts/re-seed.sh",
    "set-role": "bash scripts/set-role.sh",
    "test": "vitest run",
    "ship": "bash scripts/deploy.sh",
    "dc": "node --no-warnings scripts/dc.ts",
    "mint-token": "node --no-warnings scripts/mint-token.ts"
  },
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "@paralleldrive/cuid2": "3.3.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "@trpc/client": "^11.29.5",
    "@trpc/server": "^11.29.5",
    "@trpc/tanstack-react-query": "^11.29.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "i18next": "^27.2.2",
    "lucide-react": "^1.77.0",
    "maplibre-gl": "^6.19.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@cloudflare/vite-plugin": "^1.70.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0",
    "yaml": "^2.9.1"
  }
}
